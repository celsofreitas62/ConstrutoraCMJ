<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    SistemaCMJ.Api - camada fina entre as telas (HTML/JS) e o SQL Server.
    Autentica, confere a sessão, grava o contexto do usuário, chama as
    procedures e devolve JSON. Regra de negócio fica no SQL (CLAUDE.md seção 2).
    Bibliotecas: Microsoft.Data.SqlClient (MIT) e MailKit (MIT, envio de e-mail; 17/11/2026),
    Microsoft.Extensions.Hosting.WindowsServices (MIT, Microsoft; serviço do Windows; 20/11/2026),
    Microsoft.Extensions.FileProviders.Embedded (MIT, Microsoft; telas embutidas no executável; 20/11/2026).
    wwwroot vai como recurso embutido (manifesto) e NÃO é copiado na publicação:
    no servidor não existe pasta de telas para trocar. AjudaGeral (ajuda do
    administrador geral, 03g) também vai só embutida e sai só pela API.
    Version: versão do programa (aparece em /api/saude e no registro).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SistemaCMJ.Api</RootNamespace>
    <Version>2.1.0</Version>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <AssemblyName>SistemaCMJ.Api</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.*" />
    <PackageReference Include="MailKit" Version="4.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" Exclude="wwwroot\**\desktop.ini" />
    <!-- Ajuda do administrador geral (03g): só embutida; nunca vai solta para a publicação. -->
    <Content Remove="AjudaGeral\**" />
    <None Remove="AjudaGeral\**" />
    <EmbeddedResource Include="AjudaGeral\**" Exclude="AjudaGeral\**\desktop.ini" />
    <Content Update="wwwroot\**" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
