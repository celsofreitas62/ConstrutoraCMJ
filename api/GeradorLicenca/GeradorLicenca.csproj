<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SisCMJ - Gerador de licença (CLAUDE.md seção 3.5). Fica SÓ no computador do
    Celso: nunca é publicado nem vai para o cliente. Usa o mesmo formato da API
    (Infra/LicencaFormato.cs, incluído daqui). Sem bibliotecas de terceiros.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeradorLicenca</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SistemaCMJ.Api\Infra\LicencaFormato.cs" Link="LicencaFormato.cs" />
  </ItemGroup>

</Project>
